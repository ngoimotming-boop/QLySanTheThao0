<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8fafc;
            }

            .sidebar {
                min-height: 100vh;
                background-color: #0f172a;
                color: #fff;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

                .sidebar .brand {
                    padding: 20px;
                    font-size: 1.2rem;
                    font-weight: bold;
                    border-bottom: 1px solid #1e293b;
                    color: #38bdf8;
                }

            /* Tùy chỉnh khối Account Sidebar */
            .sidebar-account {
                padding: 12px 16px;
                margin: 12px;
                background-color: #1e293b;
                border-radius: 10px;
                border: 1px solid #334155;
            }

                .sidebar-account .dropdown-toggle::after {
                    margin-left: auto;
                    color: #94a3b8;
                }

            .sidebar .nav-link {
                color: #94a3b8;
                padding: 10px 18px;
                font-weight: 500;
                border-radius: 8px;
                margin: 3px 12px;
                display: flex;
                align-items: center;
                transition: all 0.2s ease;
                font-size: 0.92rem;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background-color: #0284c7;
                    color: #fff;
                }

                .sidebar .nav-link i {
                    margin-right: 12px;
                    font-size: 1.15rem;
                }

            .sidebar .menu-header {
                font-size: 0.72rem;
                text-transform: uppercase;
                color: #64748b;
                font-weight: 700;
                padding: 10px 20px 4px;
                margin-top: 6px;
            }

            .main-content {
                padding: 30px;
            }

            .card {
                border: none;
                border-radius: 12px;
                box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 px-0 sidebar">
                <!-- PHẦN TRÊN: Brand, Account & Menu -->
                <div>
                    <div class="brand">
                        <i class="bi bi-shield-lock-fill me-2"></i>ADMIN PORTAL
                    </div>

                    <!-- KHỐI ACCOUNT DROPDOWN -->
                    <div class="sidebar-account">
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-white"
                               id="adminAccountDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2"
                                     style="width: 36px; height: 36px; min-width: 36px;">
                                    A
                                </div>
                                <div class="lh-sm overflow-hidden me-2" style="max-width: 110px;">
                                    <div class="fw-semibold text-truncate small">Quản trị viên</div>
                                    <div class="text-secondary text-truncate" style="font-size: 11px; color: #94a3b8 !important;">Admin System</div>
                                </div>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-dark shadow border-0 rounded-3 mt-2 py-2" aria-labelledby="adminAccountDropdown" style="background-color: #1e293b;">
                                <li>
                                    <a class="dropdown-item py-2 small text-danger fw-medium" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <ul class="nav nav-pills flex-column mt-1">
                        <div class="menu-header">Quản lý chính</div>
                        <li class="nav-item">
                            <a href="/Admin" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <i class="bi bi-speedometer2"></i>Tổng quan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/ManageCourts" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageCourts" ? "active" : "")">
                                <i class="bi bi-dribbble"></i>Quản lý Sân
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/ManageBookings" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageBookings" ? "active" : "")">
                                <i class="bi bi-calendar-check"></i>Duyệt Đặt Sân
                            </a>
                        </li>
                        <!-- Đã thêm: Báo cáo & Thống kê -->
                        <li class="nav-item">
                            <a href="/Admin/Reports" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Reports" ? "active" : "")">
                                <i class="bi bi-bar-chart-line"></i>Báo cáo & Thống kê
                            </a>
                        </li>

                        <div class="menu-header">Hệ thống & Phân quyền</div>
                        <li class="nav-item">
                            <a href="/Admin/ManageUsers" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "ManageUsers" ? "active" : "")">
                                <i class="bi bi-people"></i>Tài khoản & Quyền
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Pricing" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Pricing" ? "active" : "")">
                                <i class="bi bi-tags"></i>Bảng giá & Giờ vàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Admin/Settings" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")">
                                <i class="bi bi-gear"></i>Cấu hình Hệ thống
                            </a>
                        </li>
                        <!-- Đã thêm: Nhật ký hoạt động -->
                        <li class="nav-item">
                            <a href="/Admin/AuditLogs" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "AuditLogs" ? "active" : "")">
                                <i class="bi bi-clock-history"></i>Nhật ký Hoạt động
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- PHẦN DƯỚI CÙNG (CỐ ĐỊNH Ở ĐÁY SIDEBAR): Nút xem nhanh trang Khách & Version -->
                <div class="p-3 border-top border-secondary border-opacity-25">
                    <a href="/" class="btn btn-outline-light w-100 rounded-3 btn-sm d-flex align-items-center justify-content-center py-2 mb-2" style="font-size: 0.82rem;">
                        <i class="bi bi-box-arrow-up-right me-2"></i> Xem trang Đặt Sân
                    </a>
                    <div class="text-center text-muted" style="font-size: 0.7rem;">
                        Quản lý Sân Thể Thao &bull; v1.0.0
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-md-9 col-lg-10 main-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>