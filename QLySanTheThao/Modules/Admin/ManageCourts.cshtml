@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<QLySanTheThao.Core.Entities.Court>
@{
    Layout = "/Modules/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Sân";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Danh sách Sân Thể Thao</h3>
        <p class="text-muted mb-0">Quản lý cơ sở vật chất và trạng thái hoạt động thực tế</p>
    </div>
    <button class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCourtModal">
        <i class="bi bi-plus-lg me-1"></i>Thêm Sân Mới
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thanh lọc & Tìm kiếm -->
<div class="card border-0 shadow-sm p-3 rounded-4 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0" placeholder="Tìm theo tên sân, loại sân..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="statusFilter" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Sẵn sàng" selected="@(ViewData["StatusFilter"]?.ToString() == "Sẵn sàng")">Sẵn sàng</option>
                <option value="Đang sử dụng" selected="@(ViewData["StatusFilter"]?.ToString() == "Đang sử dụng")">Đang sử dụng</option>
                <option value="Bảo trì" selected="@(ViewData["StatusFilter"]?.ToString() == "Bảo trì")">Bảo trì</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100 rounded-pill"><i class="bi bi-funnel me-1"></i>Lọc</button>
        </div>
    </form>
</div>

<!-- Bảng hiển thị Sân -->
<div class="card border-0 shadow-sm p-4 rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 10%;">ID</th>
                    <th style="width: 35%;">Tên Sân</th>
                    <th style="width: 25%;">Loại Sân</th>
                    <th style="width: 20%;">Trạng Thái</th>
                    <th class="text-end" style="width: 10%;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var court in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@court.Id</td>
                            <td class="fw-bold text-dark">@court.Name</td>
                            <td><span class="badge bg-secondary bg-opacity-10 text-dark border px-3 py-2 rounded-pill">@court.Type</span></td>
                            <td>
                                @if (court.Status == "Sẵn sàng")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">Sẵn sàng</span>
                                }
                                else if (court.Status == "Đang sử dụng")
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-2 rounded-pill">Đang sử dụng</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 rounded-pill">Bảo trì</span>
                                }
                            </td>
                            <td class="text-end">
                                <!-- Nút Sửa mở Modal sử dụng data-* attributes an toàn tuyệt đối với chuỗi có khoảng trắng -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-circle me-1 edit-court-btn"
                                        title="Sửa thông tin"
                                        data-id="@court.Id"
                                        data-name="@court.Name"
                                        data-type="@court.Type"
                                        data-status="@court.Status">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <!-- Form Xóa trực tiếp gọi Action /Admin/DeleteCourt -->
                                <form asp-controller="Admin" asp-action="DeleteCourt" asp-route-id="@court.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sân này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa sân">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có sân nào trong hệ thống. Bấm "Thêm Sân Mới" để tạo!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Sân -->
<div class="modal fade" id="addCourtModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm Sân Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="CreateCourt" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên sân</label>
                        <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Sân Cầu Lông 04" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Loại sân</label>
                        <select name="Type" class="form-select" required>
                            <option value="Sân đôi">Sân đôi</option>
                            <option value="Sân đơn">Sân đơn</option>
                            <option value="Sân VIP">Sân VIP</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái ban đầu</label>
                        <select name="Status" class="form-select">
                            <option value="Sẵn sàng">Sẵn sàng</option>
                            <option value="Bảo trì">Bảo trì</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Tạo sân mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Sân -->
<div class="modal fade" id="editCourtModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Cập Nhật Thông Tin Sân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="EditCourt" method="post">
                <div class="modal-body">
                    <input type="hidden" id="editCourtId" name="Id" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên sân</label>
                        <input type="text" id="editCourtName" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Loại sân</label>
                        <select id="editCourtType" name="Type" class="form-select" required>
                            <option value="Sân đôi">Sân đôi</option>
                            <option value="Sân đơn">Sân đơn</option>
                            <option value="Sân VIP">Sân VIP</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái</label>
                        <select id="editCourtStatus" name="Status" class="form-select">
                            <option value="Sẵn sàng">Sẵn sàng</option>
                            <option value="Đang sử dụng">Đang sử dụng</option>
                            <option value="Bảo trì">Bảo trì</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Lưu cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Bắt sự kiện click nút Sửa bằng data attribute (tránh lỗi ký tự đặc biệt/khoảng trắng trong JS)
        document.querySelectorAll('.edit-court-btn').forEach(button => {
            button.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                const type = this.getAttribute('data-type');
                const status = this.getAttribute('data-status');

                document.getElementById('editCourtId').value = id;
                document.getElementById('editCourtName').value = name;
                document.getElementById('editCourtType').value = type;
                document.getElementById('editCourtStatus').value = status;

                var modal = new bootstrap.Modal(document.getElementById('editCourtModal'));
                modal.show();
            });
        });
    });
</script>