@model IEnumerable<QLySanTheThao.Core.Entities.User>
@{
    Layout = "/Modules/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Tài khoản & Phân quyền";
}

<div class="container-fluid px-0 py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Phân hệ Quản lý Tài khoản & Phân quyền</h3>
            <p class="text-muted mb-0">Quản lý danh sách thành viên và phân quyền nhân sự hệ thống sân cầu lông</p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                <i class="bi bi-person-plus-fill me-2"></i>Thêm nhân sự mới
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THANH ĐIỀU HƯỚNG TAB -->
    <ul class="nav nav-tabs nav-fill mb-4 border-0 gap-2" id="userTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold py-3 rounded-4 shadow-sm bg-white text-dark border-0" id="staff-tab" data-bs-toggle="tab" data-bs-target="#staff-pane" type="button" role="tab">
                <i class="bi bi-shield-lock-fill text-primary me-2 fs-5"></i>Nhân sự & Quản trị viên (Nội bộ)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold py-3 rounded-4 shadow-sm bg-white text-dark border-0" id="customer-tab" data-bs-toggle="tab" data-bs-target="#customer-pane" type="button" role="tab">
                <i class="bi bi-people-fill text-success me-2 fs-5"></i>Khách hàng đặt sân (Thành viên)
            </button>
        </li>
    </ul>

    <!-- NỘI DUNG CÁC TAB -->
    <div class="tab-content" id="userTabsContent">
        <!-- TAB 1: NHÂN SỰ NỘI BỘ -->
        <div class="tab-pane fade show active" id="staff-pane" role="tabpanel">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <h5 class="fw-bold mb-3 text-secondary">Danh sách Quản trị và Lễ tân trực sân</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">Họ và tên</th>
                                <th class="py-3">Email đăng nhập</th>
                                <th class="py-3">Số điện thoại</th>
                                <th class="py-3">Chức vụ / Vai trò</th>
                                <th class="py-3">Trạng thái</th>
                                <th class="py-3 text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px;">A</div>
                                        Quản trị viên Hệ thống
                                    </div>
                                </td>
                                <td>admin@sanbadminton.vn</td>
                                <td>0901234567</td>
                                <td><span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Administrator</span></td>
                                <td><span class="badge bg-success bg-opacity-10 text-success">Đang hoạt động</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary rounded-3" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px;">N</div>
                                        Nguyễn Văn Lễ Tân
                                    </div>
                                </td>
                                <td>letan@sanbadminton.vn</td>
                                <td>0988777666</td>
                                <td><span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">Nhân viên Lễ tân</span></td>
                                <td><span class="badge bg-success bg-opacity-10 text-success">Đang hoạt động</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary rounded-3" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: KHÁCH HÀNG ĐẶT SÂN (Lấy trực tiếp từ Database) -->
        <div class="tab-pane fade" id="customer-pane" role="tabpanel">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-secondary">Danh sách Khách hàng thân thiết</h5>
                    <form asp-action="ManageUsers" method="get" class="input-group w-25">
                        <input type="text" name="searchString" value="@Context.Request.Query["searchString"]" class="form-control form-control-sm rounded-start-3" placeholder="Tìm kiếm khách hàng...">
                        <button class="btn btn-outline-primary btn-sm rounded-end-3" type="submit"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3">ID</th>
                                <th class="py-3">Họ tên khách hàng</th>
                                <th class="py-3">Email</th>
                                <th class="py-3">Số điện thoại</th>
                                <th class="py-3">Trạng thái tài khoản</th>
                                <th class="py-3 text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var user in Model)
                                {
                                    <tr>
                                        <td>#@user.Id</td>
                                        <td class="fw-semibold">@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>@user.PhoneNumber</td>
                                        <td><span class="badge bg-success bg-opacity-10 text-success">Hoạt động</span></td>
                                        <td class="text-end">
                                            <!-- Nút mở Modal Chỉnh sửa -->
                                            <button class="btn btn-sm btn-outline-secondary rounded-3 me-1" data-bs-toggle="modal" data-bs-target="#editUserModal@(user.Id)" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <!-- Nút Khóa tài khoản -->
                                            <form asp-action="LockUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản này không?');" title="Khóa tài khoản">
                                                    <i class="bi bi-lock"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu khách hàng trong hệ thống.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Nhân Sự Mới -->
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold text-primary"><i class="bi bi-person-plus me-2"></i>Thêm Nhân sự Nội bộ Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <form asp-action="CreateStaff" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên nhân viên</label>
                        <input type="text" name="fullName" class="form-control rounded-3" placeholder="Ví dụ: Nguyễn Văn A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email nội bộ</label>
                        <input type="email" name="email" class="form-control rounded-3" placeholder="staff@sanbadminton.vn" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số điện thoại</label>
                        <input type="text" name="phoneNumber" class="form-control rounded-3" placeholder="090..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phân quyền vai trò</label>
                        <select name="role" class="form-select rounded-3">
                            <option value="Staff">Nhân viên Lễ tân (Duyệt đơn, Quản lý sân)</option>
                            <option value="Admin">Quản trị viên tối cao (Admin)</option>
                        </select>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-light rounded-pill px-4 me-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Tạo tài khoản</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa cho từng User -->
@if (Model != null && Model.Any())
{
    foreach (var user in Model)
    {
        <div class="modal fade" id="editUserModal@(user.Id)" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin tài khoản #@user.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-3">
                        <form asp-action="EditUser" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Họ và tên</label>
                                <input type="text" name="fullName" value="@user.FullName" class="form-control rounded-3" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" name="email" value="@user.Email" class="form-control rounded-3" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Số điện thoại</label>
                                <input type="text" name="phoneNumber" value="@user.PhoneNumber" class="form-control rounded-3" required />
                            </div>
                            <div class="text-end mt-4">
                                <button type="button" class="btn btn-light rounded-pill px-4 me-2" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Lưu thay đổi</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}